{
  "name": "recipe-tree-visualizer",
  "description": "A tool for visualizing recipe trees",
  "author": "Mise Recipe Planner contributors",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "node --test",
    "test:ui": "npm run build && node scripts/mobile-ui.cjs",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "serve": "python website/serve.py",
    "electron": "electron .",
    "package": "npm run build && electron-builder build --win"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "@emotion/styled": "^11.13.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@mui/icons-material": "^5.16.7",
    "@mui/material": "^5.16.7",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^9.9.0",
    "eslint-plugin-react": "^7.35.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "vite": "^5.4.1"
  },
  "main": "electron.cjs",
  "build": {
    "appId": "com.yourcompany.recipetreevisualizer",
    "productName": "Mise Recipe Planner",
    "files": [
      "dist/**/*",
      "electron.cjs",
      "preload.cjs"
    ],
    "extraResources": [{ "from": "website", "to": "website", "filter": ["*.py"] }],
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "win": {
      "target": ["nsis", "portable"]
    }
  }
}
